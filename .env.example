# Copy this file to ".env.local" and fill in the values from your Supabase project.
# Supabase dashboard → Project Settings → Data API / API Keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — Google Places Autocomplete for the event/meeting location pickers.
# Leave it unset and the pickers fall back to OpenStreetMap (Nominatim).
# Restrict the key by HTTP referrer and cap its daily quota in Cloud console;
# only the Places API needs to be enabled. See src/lib/places.js for the
# cost model (autocomplete is free per session; Place Details stays Essentials).
VITE_GOOGLE_MAPS_API_KEY=your-browser-key
